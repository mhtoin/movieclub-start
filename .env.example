# The Movie Database API
VITE_TMDB_API_KEY=your_api_key_here
VITE_TMDB_BASE_URL=https://api.themoviedb.org/3
VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Shortlist card experiment: use "stub" to enable the ticket-style variant
VITE_SHORTLIST_CARD_VARIANT=default

# Base URL for OAuth callbacks
BASE_URL=http://localhost:3001

# Session cookie encryption secret (at least 32 characters)
# Generate with: openssl rand -hex 32
SESSION_PASSWORD=YOUR_64_CHARACTER_SECRET_HERE

# Discord OAuth
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
