# Production Environment Configuration
# Copy this file to .env.production and fill in the actual values

# Database Configuration
POSTGRES_USER=movieclub
POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD_HERE
POSTGRES_DB=movieclub

# Authentication
# Generate with: openssl rand -hex 32
SESSION_PASSWORD=YOUR_64_CHARACTER_SECRET_HERE
BASE_URL=https://your-domain.example

# Email
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=MovieClub <noreply@your-domain.example>

# The Movie Database API
# Get your API key from: https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your_tmdb_api_key_here
VITE_TMDB_BASE_URL=https://api.themoviedb.org/3
VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Shortlist card experiment: use "stub" to enable the ticket-style variant
VITE_SHORTLIST_CARD_VARIANT=default

# Optional OAuth and integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_WEBHOOK_URL=
